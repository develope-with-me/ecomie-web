  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build && npm run clean",
    "build:dev": "vite build --mode development",
    "preview": "npm run build && vite preview",
    "clean": "find src/react-app -name \"*.js\" ! -name \"*.tsx\" -delete && find src/react-app -name \"*.d.ts\" ! -name \"*.d.tsx\" ! -name \"images.d.ts\" ! -name \"*env.d.ts\" -delete",
    "test": "vitest",
    "lint": "eslint .",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
